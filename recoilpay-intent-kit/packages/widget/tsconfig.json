{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": [
      "vitest/globals"
    ],
    "paths": {
      "@recoilpay/intent-core": [
        "../core/src/index.ts"
      ],
      "@recoilpay/intent-react": [
        "../react/src/index.ts"
      ],
      "@recoilpay/intent-react/styles.css": [
        "../react/src/styles.css"
      ]
    }
  },
  "include": [
    "src",
    "test"
  ]
}
