{
  "name": "@recoilpay/intent-react",
  "version": "0.2.0",
  "description": "Drop-in React component for RecoilPay intents: type a swap or send in plain English, quote across solvers, confirm, track.",
  "keywords": [
    "recoilpay",
    "intents",
    "cross-chain",
    "swap",
    "react",
    "component",
    "wagmi"
  ],
  "homepage": "https://docs.recoilpay.com/integrate/react",
  "license": "MIT",
  "author": "Recoil Labs",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./wagmi": {
      "import": {
        "types": "./dist/wagmi.d.ts",
        "default": "./dist/wagmi.js"
      },
      "require": {
        "types": "./dist/wagmi.d.cts",
        "default": "./dist/wagmi.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "wagmi": [
        "./dist/wagmi.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup src/index.ts src/wagmi.ts --format esm,cjs --dts --clean --external react --external wagmi && cp src/styles.css dist/styles.css",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@recoilpay/intent-core": "^0.2.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "viem": "^2.21.0",
    "wagmi": "^2.0.0"
  },
  "peerDependenciesMeta": {
    "wagmi": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.104.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "jsdom": "^29.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "viem": "^2.56.9",
    "vitest": "^5.0.2",
    "wagmi": "^2.19.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
