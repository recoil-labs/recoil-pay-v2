# ── OIF aggregator ──
# Base URL of the OIF aggregator the intent UI talks to.
# Live (default if unset): https://api.recoilpay.com
# Local dev:               http://127.0.0.1:4000
VITE_OIF_API_BASE_URL=https://recoil-aggregator-675174162902.us-central1.run.app

# ── WalletConnect ──
# Public project id (ships in the bundle). Create one at https://cloud.reown.com
# Required for WalletConnect/mobile; injected wallets (MetaMask) work without it.
VITE_WALLETCONNECT_PROJECT_ID=

# ── Hugging Face Inference API ──
# Free token used to run the NLP intent parser model.
# Create an account at https://huggingface.co and generate a token in your settings.
VITE_HF_ACCESS_TOKEN=

# ── Ghost blog (blog.recoilpay.com) ──
# Public Content API key + base URL. Used by the homepage "From the blog"
# section to list the latest posts. Create the key in Ghost Admin →
# Settings → Integrations → Add custom integration. The Content API is
# read-only and designed to be shipped in the client.
VITE_GHOST_API_URL=https://blog.recoilpay.com
VITE_GHOST_CONTENT_KEY=
