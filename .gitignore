# ── Secrets ─────────────────────────────────────────────────────────
# Never commit these. A .env reached the old solvers repo once and had
# to be scrubbed; the allowlist below keeps only the templates.
.env
.env.*
!.env.example
!.env.sample
!.env.template
*.pem
*.key
*credentials*.json
*service-account*.json

# ── Rust ────────────────────────────────────────────────────────────
# The aggregator and solver target dirs are ~29GB combined.
target/
**/target/
*.rs.bk

# ── Dependencies / build output ─────────────────────────────────────
node_modules/
dist/
build/
.vite/
*.tsbuildinfo

# ── Anchor / Solana ─────────────────────────────────────────────────
.anchor/
test-ledger/

# ── Runtime state ───────────────────────────────────────────────────
data/storage/

# ── Tooling / OS ────────────────────────────────────────────────────
.DS_Store
*.log
.idea/
.vscode/
