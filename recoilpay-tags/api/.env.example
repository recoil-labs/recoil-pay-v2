# Postgres. Omit locally to use an on-disk PGlite in api/.pglite.
DATABASE_URL=

# The public origin people sign for and share. Messages signed on any other
# origin are rejected unless listed in ALLOWED_ORIGINS.
PUBLIC_ORIGIN=https://tags.recoilpay.com
ALLOWED_ORIGINS=http://localhost:5173

# Only for the split deploy (static site on its own origin calling this API).
CORS_ORIGINS=

# Optional RPC overrides; viem's public endpoints are used otherwise.
# Used for ENS names and smart-wallet (ERC-1271/6492) signature checks.
RPC_URL_1=
RPC_URL_8453=
RPC_URL_42161=
RPC_URL_10=
RPC_URL_137=

# Where the built page lives. Served (with per-tag share metadata) when present.
WEB_DIST=../web/dist
PORT=8787
