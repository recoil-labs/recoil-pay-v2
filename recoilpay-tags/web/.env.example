# Public WalletConnect project id (ships in the bundle). Optional: defaults to
# RecoilPay's project (see src/lib/wallet.ts). Its Reown dashboard must allow
# this site's domains — tags.recoilpay.com, and localhost for dev.
VITE_WALLETCONNECT_PROJECT_ID=

# Only when the page is deployed separately from the API (the Staticfile
# deploy). Leave empty when the API serves the page.
VITE_API_URL=
