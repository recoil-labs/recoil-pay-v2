# Public WalletConnect project id (ships in the bundle) — https://cloud.reown.com
# Injected wallets work without it; WalletConnect / mobile wallets need it.
VITE_WALLETCONNECT_PROJECT_ID=

# Only when the page is deployed separately from the API (the Staticfile
# deploy). Leave empty when the API serves the page.
VITE_API_URL=
