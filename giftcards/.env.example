# The aggregator this dashboard talks to. Without it the app sends relative
# paths, which in production means requests to its own origin and a 404.
VITE_API_BASE_URL=https://api.recoilpay.com

# WalletConnect project id, from https://cloud.reown.com. Public — it ships
# in the client bundle. Without a real one every WalletConnect and mobile
# wallet fails to connect, while injected extensions keep working; that is
# why the breakage presents as "mobile wallets don't work" rather than as an
# outright error.
VITE_WALLETCONNECT_PROJECT_ID=
